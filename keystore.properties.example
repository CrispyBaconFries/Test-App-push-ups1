# Copy this file to "keystore.properties" (same folder, repo root) and fill in your own
# values - see README.md "Play-Store-Veröffentlichung". "keystore.properties" itself is
# gitignored on purpose: it holds real passwords and must never be committed.
#
# storeFile is a filename relative to the repo root (where this file lives), e.g. the
# release.keystore you generate with:
#   keytool -genkeypair -v -keystore release.keystore -alias pushup-coach -keyalg RSA -keysize 2048 -validity 10000
storeFile=release.keystore
storePassword=CHANGE_ME
keyAlias=pushup-coach
keyPassword=CHANGE_ME
