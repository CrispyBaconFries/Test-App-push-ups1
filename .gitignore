# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision

# Google / Firebase config (not used yet - the Google Sign-In config plugin runs
# without Firebase - but ignored defensively in case that ever changes)
google-services.json
GoogleService-Info.plist

# Real release-signing credentials (see keystore.properties.example, which IS committed)
keystore.properties

# Welches Firebase-Projekt diese Arbeitskopie gerade benutzt - schreibt die Firebase-CLI
# selbst (`firebase use --add`, siehe docs/firebase-einrichten.md). Bewusst nicht
# eingecheckt: Es ist eine Angabe zur jeweiligen Maschine, nicht zum Projekt, und
# firebase.json (das die Regel-Pfade festlegt) IST eingecheckt.
.firebaserc

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# downloaded ML models (fetched via `npm run model:download`, see README.md)
assets/models/*.task
assets/models/*.tflite

# Android Studio / IntelliJ project settings (machine-specific)
.idea/
