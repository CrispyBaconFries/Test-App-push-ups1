rules_version = '2';

// Starter Security Rules für das Ranking-System. Mit der Firebase CLI deployen:
//   firebase deploy --only firestore:rules
// (setzt ein Firebase-Projekt + `firebase init` voraus, siehe README
// "Ranking-System einrichten"). Absichtlich einfach gehalten fürs MVP - siehe die
// Kommentare unten für bekannte Grenzen.
service cloud.firestore {
  match /databases/{database}/documents {

    // Spielerprofil (Anzeigename, Foto, LP, Rang, Siege/Niederlagen, Gesamt-/
    // Wochen-Liegestütze fürs Rangliste-Feature).
    // Lesen: jeder eingeloggte Nutzer (nötig für Matchmaking/Ranglisten).
    // Schreiben: nur der Profil-Inhaber selbst.
    //
    // Bekannte Grenze: ohne Cloud Function könnte ein manipulierter Client
    // theoretisch seine eigenen LP-/Sieg-/Liegestütz-Werte direkt schreiben. Für ein
    // Hobby-Projekt ohne echten Wettbewerbsdruck akzeptabel; der saubere Fix wäre,
    // LP-Änderungen und Liegestütz-Zähler ausschließlich serverseitig (Cloud
    // Function) auf Basis der `matches`-Einträge bzw. signierter Session-Daten zu
    // berechnen und hier nur noch Lesezugriff zu erlauben.
    match /players/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Matchmaking-Warteschlange: ein Spieler legt/löscht nur seinen eigenen Eintrag.
    // `update` bleibt für alle eingeloggten Nutzer offen, weil der Gegner genau diesen
    // Eintrag per Transaktion "claimen" (als vergeben markieren) muss.
    match /rankedQueue/{uid} {
      allow read: if request.auth != null;
      allow create, delete: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null;
    }

    // Abgeschlossene Duelle (Historie/Statistik). Nur die beiden Teilnehmer dürfen
    // ihn anlegen (einmalig) bzw. lesen; nachträgliches Ändern/Löschen ist gesperrt.
    match /matches/{matchId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.playerIds;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.playerIds;
      allow update, delete: if false;
    }
  }
}
