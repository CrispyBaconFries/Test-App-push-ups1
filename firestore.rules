rules_version = '2';

// Security Rules für Rangliste, Matchmaking, Duell-Historie und Länderspiel.
// Deployen mit der Firebase CLI:
//   firebase deploy --only firestore:rules
// (setzt ein Firebase-Projekt + `firebase init` voraus, siehe README
// "Ranking-System einrichten", Abschnitt "Sicherheit").
//
// GRUNDSATZ: Dieses Projekt hat bewusst keine Cloud Functions - es gibt also niemanden
// außer den Clients selbst, der schreibt. Die Regeln können deshalb nicht garantieren,
// dass ein Wert *stimmt*; sie erzwingen stattdessen, dass jeder Wert sich nur so
// verändern kann, wie die App ihn verändert:
//   - Fremde Datensätze sind unantastbar (jeder schreibt nur sein eigenes Dokument).
//   - Zähler und Rekorde wachsen nur, sie schrumpfen nie.
//   - Zuwächse sind pro Schreibzugriff gedeckelt (keine "eine Million Liegestütze"-Zeile).
//   - Einmal festgelegte Dinge (Länderwahl, veröffentlichtes Ergebnis, Freundescode)
//     lassen sich nachträglich nicht mehr ändern.
// Was das NICHT verhindert: dass jemand mit einem manipulierten Client über viele
// Schreibzugriffe langsam unehrliche Werte aufbaut. Der belastbare Schutz dagegen wäre
// Firebase App Check (siehe README) plus serverseitige Auswertung.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Spielerprofil (Anzeigename, Avatar, LP, Siege/Niederlagen, Gesamt-/Wochen-
    // Liegestütze, persönliche Rekorde).
    // Lesen: jeder eingeloggte Nutzer (nötig für Matchmaking und Ranglisten).
    // Schreiben: nur der Profil-Inhaber selbst - und auch der nur in den Bahnen unten.
    match /players/{uid} {

      // `.get(feld, ersatz)` statt `data.feld`: Profile aus der Zeit vor den
      // persönlichen Rekorden haben `bestDayReps` & Co. gar nicht. Ohne Ersatzwert
      // würde die Regel bei genau diesen Profilen mit einem Fehler abbrechen und
      // damit jeden Sync blockieren.
      function incoming(field, fallback) {
        return request.resource.data.get(field, fallback);
      }
      function stored(field, fallback) {
        return resource.data.get(field, fallback);
      }
      function unchanged(field) {
        return incoming(field, null) == stored(field, null);
      }
      /** Zahl, nie kleiner als bisher - für Zähler und Rekorde. */
      function neverShrinks(field) {
        return incoming(field, 0) is number && incoming(field, 0) >= stored(field, 0);
      }
      function grewAtMost(field, maxDelta) {
        return incoming(field, 0) - stored(field, 0) <= maxDelta;
      }
      function startsAtZero(field) {
        return incoming(field, 0) == 0;
      }

      // Obergrenze für einen einzelnen Sync. `syncTrainingProgress` (playerProfileStore.ts)
      // schreibt immer genau EINE Trainingseinheit gut - auch beim Nachholen aus der
      // Offline-Warteschlange, die Eintrag für Eintrag abgearbeitet wird
      // (leaderboardSync.ts). 5000 Liegestütze am Stück liegen weit über jedem
      // Weltrekord und damit weit außerhalb dessen, was ehrlich entstehen kann.
      function maxRepsPerWrite() {
        return 5000;
      }
      // Höchstmögliche Punkte je Liegestütz laut `pointsForRep` (points.ts):
      // 10 Grundpunkte + 5 Bonus bei perfekter Form. Punkte dürfen deshalb nur im
      // Verhältnis zu tatsächlich dazugekommenen Liegestützen wachsen.
      function maxPointsPerRep() {
        return 15;
      }
      // Größte LP-Änderung eines einzelnen Duells: `WIN_LP_MAX` in lp.ts ist 35, eine
      // Niederlage kostet höchstens 60 % davon. 40 lässt etwas Luft, deckelt aber den
      // Sprung von 0 auf "Legende" in einem Schritt.
      function maxLpDelta() {
        return 40;
      }

      allow read: if signedIn();

      // Anlegen: nur für sich selbst, und bei null anfangen. Sonst könnte ein
      // manipulierter Client sein Profil direkt mit fertigen Rekorden erzeugen und die
      // "wächst nur"-Regeln unten damit umgehen.
      allow create: if signedIn()
                    && request.auth.uid == uid
                    && request.resource.data.uid == uid
                    && request.resource.data.displayName is string
                    && request.resource.data.displayName.size() <= 60
                    && startsAtZero('lp')
                    && startsAtZero('wins')
                    && startsAtZero('losses')
                    && startsAtZero('totalReps')
                    && startsAtZero('weeklyReps')
                    && startsAtZero('totalPoints')
                    && startsAtZero('bestDayReps')
                    && startsAtZero('bestSessionReps')
                    && startsAtZero('longestStreakDays');

      allow update: if signedIn()
                    && request.auth.uid == uid
                    // Identität ist unveränderlich: `uid` ist der Schlüssel des
                    // Dokuments, und über `friendCode` finden Freunde einen wieder
                    // (friendsStore.ts) - ein wechselnder Code würde bestehende
                    // Freundeslisten still ins Leere laufen lassen.
                    && unchanged('uid')
                    && unchanged('friendCode')
                    && incoming('displayName', '') is string
                    && incoming('displayName', '').size() <= 60
                    // Zähler und Rekorde wachsen nur.
                    && neverShrinks('totalReps')
                    && neverShrinks('totalPoints')
                    && neverShrinks('wins')
                    && neverShrinks('losses')
                    && neverShrinks('bestDayReps')
                    && neverShrinks('bestSessionReps')
                    && neverShrinks('longestStreakDays')
                    // ... und zwar in Schritten, die eine echte Trainingseinheit bzw.
                    // ein echtes Duell hergibt.
                    && grewAtMost('totalReps', maxRepsPerWrite())
                    && grewAtMost('totalPoints', (incoming('totalReps', 0) - stored('totalReps', 0)) * maxPointsPerRep())
                    && grewAtMost('wins', 1)
                    && grewAtMost('losses', 1)
                    // `weeklyReps` ist bewusst NICHT monoton: Es wird beim ersten Sync
                    // einer neuen Woche zurückgesetzt (siehe `syncTrainingProgress`).
                    && incoming('weeklyReps', 0) is number
                    && incoming('weeklyReps', 0) >= 0
                    && incoming('weeklyReps', 0) - stored('weeklyReps', 0) <= maxRepsPerWrite()
                    && incoming('lp', 0) is number
                    && incoming('lp', 0) >= 0
                    && incoming('lp', 0) - stored('lp', 0) <= maxLpDelta()
                    && stored('lp', 0) - incoming('lp', 0) <= maxLpDelta();

      // Kein Löschen: Ein gelöschtes Profil ließe sich anschließend frisch anlegen -
      // und damit wären alle "wächst nur"-Regeln oben wirkungslos (Rekord runtersetzen
      // ginge dann über den Umweg löschen + neu anlegen).
      allow delete: if false;

      // Freundesliste (Rangliste-Tab "Freunde"): wer per Code hinzugefügt wurde.
      // Bewusst einseitig (siehe friendsStore.ts) - deshalb reicht "nur der Besitzer
      // selbst" für Lesen *und* Schreiben, niemand sonst braucht Zugriff auf die Liste
      // eines anderen Nutzers.
      match /friends/{friendUid} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn()
                      && request.auth.uid == uid
                      && request.resource.data.uid == friendUid;
        allow update: if false;
      }
    }

    // Matchmaking-Warteschlange: ein Spieler legt/löscht nur seinen eigenen Eintrag.
    //
    // `update` muss auch für ANDERE offen sein, weil der Gegner genau diesen Eintrag per
    // Transaktion "claimt" (tryClaimCandidate in matchmakingQueue.ts). Offen heißt hier
    // aber nicht beliebig: Erlaubt ist ausschließlich der Übergang
    // waiting -> matched samt Duellcode. Vorher durfte jeder eingeloggte Nutzer jedes
    // Feld eines fremden Warteschlangen-Eintrags überschreiben - inklusive `lp`, mit dem
    // die Gegnersuche arbeitet.
    match /rankedQueue/{uid} {

      // Der einzige Zugriff, den ein FREMDER auf diesen Eintrag haben darf.
      function claimTransition() {
        return request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'matchedDuelCode'])
               && resource.data.status == 'waiting'
               && request.resource.data.status == 'matched'
               && request.resource.data.matchedDuelCode is string
               && request.resource.data.matchedDuelCode.size() <= 12;
      }

      allow read: if signedIn();
      allow create, delete: if signedIn() && request.auth.uid == uid;

      // Der Besitzer darf seinen Eintrag komplett neu setzen: `joinQueue` schreibt mit
      // `setDoc` ohne Merge, und wenn noch ein alter Eintrag herumliegt (App mitten in
      // der Suche beendet), ist genau das ein Update und kein Create. Ihn darauf
      // einzuschränken würde nichts bringen - was er hier einträgt, könnte er beim
      // Anlegen genauso eintragen.
      allow update: if signedIn() && (request.auth.uid == uid || claimTransition());
    }

    // Länderspiel: Eckdaten und (nach Ende) das veröffentlichte Ergebnis eines Events.
    //
    // Das Ergebnis schreibt der erste Client, der nach dem Ende hinschaut (siehe
    // nationsStore.ts, `loadOrFinalizeResult`) - ohne Cloud Function gibt es niemanden
    // sonst, der das tun könnte. Die Regeln engen das so weit ein, wie es ohne Server
    // geht: Ein Ergebnis darf erst nach dem Eventende entstehen, der Zeitraum lässt sich
    // nachträglich nicht mehr verschieben, und ein einmal veröffentlichtes Ergebnis ist
    // endgültig.
    match /nationsEvents/{eventId} {

      // Die Dokument-ID IST der Starttag (`YYYY-MM-DD`, siehe `windowFromStartDay` in
      // nationsEvent.ts). Daran lässt sich der behauptete Zeitraum festnageln - sonst
      // könnte der erste Schreiber einfach ein längst vergangenes `endsAtMs` eintragen
      // und im selben Moment ein Wunschergebnis veröffentlichen.
      function idLooksLikeDate() {
        return eventId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
      }
      function idStartMs() {
        return timestamp.date(int(eventId[0:4]), int(eventId[5:7]), int(eventId[8:10])).toMillis();
      }
      function dayMs() {
        return 86400000;
      }
      // Toleranz von zwei Tagen: `startsAtMs` hängt an Zeitzone und Startstunde des
      // Zeitplans (`utcOffsetMinutes`, `startHour`), liegt also nicht exakt auf
      // Mitternacht UTC des Starttags.
      function plausibleWindow() {
        return request.resource.data.startsAtMs is number
               && request.resource.data.endsAtMs is number
               && request.resource.data.startsAtMs >= idStartMs() - 2 * dayMs()
               && request.resource.data.startsAtMs <= idStartMs() + 2 * dayMs()
               && request.resource.data.endsAtMs > request.resource.data.startsAtMs
               && request.resource.data.endsAtMs <= request.resource.data.startsAtMs + 31 * dayMs();
      }
      function eventIsOver() {
        return request.time.toMillis() >= request.resource.data.endsAtMs;
      }

      allow read: if signedIn();

      allow create: if signedIn()
                    && idLooksLikeDate()
                    && plausibleWindow()
                    && (!('result' in request.resource.data) || eventIsOver());

      allow update: if signedIn()
                    && idLooksLikeDate()
                    && plausibleWindow()
                    // Zeitraum liegt nach dem Anlegen fest.
                    && request.resource.data.startsAtMs == resource.data.startsAtMs
                    && request.resource.data.endsAtMs == resource.data.endsAtMs
                    // Ein veröffentlichtes Ergebnis ist endgültig ...
                    && !('result' in resource.data)
                    // ... und entstehen darf es frühestens nach dem Eventende.
                    && (!('result' in request.resource.data) || eventIsOver());

      allow delete: if false;

      // Ein Spieler und sein Land. Jeder schreibt nur seinen eigenen Eintrag.
      //
      // Der wichtige Teil ist die update-Regel: Sie erzwingt, dass `countryCode` nach der
      // ersten Wahl unverändert bleibt. Die Unumkehrbarkeit hängt damit nicht daran, dass
      // die App sich benimmt - auch ein zweites Gerät oder eine ältere App-Version kann
      // die Wahl nicht mehr umbiegen. Die Liegestütze (`reps`) dürfen weiter wachsen,
      // aber wie im Spielerprofil nur nach oben und nur in realistischen Schritten.
      match /participants/{uid} {
        function validCountry(code) {
          return code is string && code.matches('^[A-Z]{2}$');
        }

        allow read: if signedIn();

        allow create: if signedIn()
                      && request.auth.uid == uid
                      && validCountry(request.resource.data.countryCode)
                      && request.resource.data.reps is number
                      && request.resource.data.reps >= 0
                      && request.resource.data.reps <= 5000;

        allow update: if signedIn()
                      && request.auth.uid == uid
                      && request.resource.data.countryCode == resource.data.countryCode
                      && request.resource.data.reps is number
                      && request.resource.data.reps >= resource.data.reps
                      && request.resource.data.reps - resource.data.reps <= 5000;

        allow delete: if false;
      }
    }

    // Abgeschlossene Duelle (Historie/Statistik). Nur die beiden Teilnehmer dürfen
    // ihn anlegen (einmalig) bzw. lesen; nachträgliches Ändern/Löschen ist gesperrt.
    match /matches/{matchId} {
      allow read: if signedIn() && request.auth.uid in resource.data.playerIds;
      allow create: if signedIn() && request.auth.uid in request.resource.data.playerIds;
      allow update, delete: if false;
    }

    // Alles, wofür oben keine Regel steht, ist ohnehin gesperrt: In Firestore gilt
    // "verboten", solange nicht mindestens eine Regel Zugriff ERLAUBT - ein `if false`
    // als Auffangblock könnte daran nichts ändern (Regeln werden ver-ODER-t, eine
    // verbietende Regel hebt eine erlaubende an anderer Stelle nicht auf). Genau deshalb
    // steht hier bewusst kein solcher Block: Er würde Sicherheit vortäuschen, die er
    // nicht liefert. Wer eine neue Sammlung anlegt, muss ihr hier eigene Regeln geben.
  }
}
